# Sali configuration via environment (prefix SALI_, nested delimiter __).
# Copy to `.env` only for local overrides; peer-auth means there is NO DB password.

# --- database (peer auth over the unix socket: no password) ---
SALI_DB__HOST=/var/run/postgresql
SALI_DB__USER=almir
SALI_DB__NAME=sali
SALI_DB__POOL_MIN=2
SALI_DB__POOL_MAX=8

# --- model (single reasoning backend: sali:latest) ---
SALI_MODEL__PROVIDER=ollama
SALI_MODEL__HOST=http://localhost:11434
SALI_MODEL__CHAT_MODEL=sali:latest
SALI_MODEL__EMBED_MODEL=nomic-embed-text
SALI_MODEL__CTX_DEFAULT=8192

# --- runtime ---
SALI_RUNTIME__MAX_ITERATIONS=8
SALI_RUNTIME__TOKEN_BUDGET_PER_RUN=24000
